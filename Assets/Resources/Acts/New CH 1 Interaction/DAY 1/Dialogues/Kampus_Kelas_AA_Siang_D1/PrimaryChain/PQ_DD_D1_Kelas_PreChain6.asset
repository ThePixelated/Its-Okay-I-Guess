  _dialogueNodes:
  - NodeID: pre6_masuk_kelas
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Ruang kelas yang sama. Kursi yang sama. Dosen yang sama yang selalu datang
      tepat waktu ketika kamu berharap dia terlambat.
    Choices: []
    NextNodeID: pre6_inner_01
  - NodeID: pre6_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Tempat duduk biasa dulu.
    Choices: []
    NextNodeID: pre6_inner_02
  - NodeID: pre6_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Oke. Buku catatan. Fokus. Bisa.
    Choices: []
    NextNodeID: pre6_inner_03
  - NodeID: pre6_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Tadi sama Dika... harusnya gue bilang...
    Choices: []
    NextNodeID: pre6_inner_04
  - NodeID: pre6_inner_04
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Udah. Nggak ada gunanya dipikirin sekarang.
