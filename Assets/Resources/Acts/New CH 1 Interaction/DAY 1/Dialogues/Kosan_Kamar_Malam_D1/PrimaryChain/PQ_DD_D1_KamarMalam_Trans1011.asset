  _dialogueNodes:
  - NodeID: trans1011_kamar_rapi
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Lumayan. Lebih manusiawi sekarang.
    Choices: []
    NextNodeID: trans1011_duduk_kasur
  - NodeID: trans1011_duduk_kasur
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: "Kamu duduk di pinggir kasur. Punggungmu terasa berat. Bukan karena capek
      beres-beres \u2014 tapi karena memang sudah berat dari tadi pagi."
    Choices: []
    NextNodeID: trans1011_inner_hitung
  - NodeID: trans1011_inner_hitung
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Saldo. Dika. Dosen. Foto wisuda itu.
    Choices: []
    NextNodeID: trans1011_inner_banyak
  - NodeID: trans1011_inner_banyak
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Banyak banget yang terjadi hari ini. Dan gue nggak ngerasa oke-oke aja.
    Choices: []
    NextNodeID: trans1011_inner_tapi
  - NodeID: trans1011_inner_tapi
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Tapi... nggak apa-apa. Ini cuma satu hari.
    Choices: []
    NextNodeID: 
