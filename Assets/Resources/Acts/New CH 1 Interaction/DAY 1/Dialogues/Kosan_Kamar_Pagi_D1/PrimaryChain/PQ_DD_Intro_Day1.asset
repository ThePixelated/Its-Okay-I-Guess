  _dialogueNodes:
  - NodeID: intro_narasi_01
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Hari ini seperti hari-hari sebelumnya. Setidaknya, begitu yang kamu katakan
      pada dirimu sendiri setiap pagi.
    Choices: []
    NextNodeID: intro_narasi_02
  - NodeID: intro_narasi_02
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Skripsi yang belum selesai. Saldo yang menipis. Deadline yang tidak pernah
      benar-benar pergi.
    Choices: []
    NextNodeID: intro_narasi_03
  - NodeID: intro_narasi_03
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Tapi tidak apa-apa. Kamu sudah terbiasa.
    Choices: []
    NextNodeID: intro_inner_01
  - NodeID: intro_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Hoamm...
    Choices: []
    NextNodeID: intro_inner_02
  - NodeID: intro_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Udah pagi...
    Choices: []
    NextNodeID: intro_inner_03
  - NodeID: intro_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Sebentar lagi. Lima menit lagi.
    Choices: []
