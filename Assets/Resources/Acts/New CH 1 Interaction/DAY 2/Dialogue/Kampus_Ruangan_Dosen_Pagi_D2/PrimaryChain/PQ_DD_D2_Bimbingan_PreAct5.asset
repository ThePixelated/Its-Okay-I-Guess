  _dialogueNodes:
  - NodeID: d2_bimbing_duduk
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Ruang dosen. Lebih kecil dari yang selalu kamu bayangkan. Atau mungkin
      kamu yang terlalu besar membayangkannya.
    Choices: []
    NextNodeID: d2_bimbing_dosen_buka
  - NodeID: d2_bimbing_dosen_buka
    SrcImgSprite: {fileID: 0}
    CharName: Dosen
    Text: Ini revisi yang terakhir kamu kirim ya?
    Choices: []
    NextNodeID: d2_bimbing_player_jawab
  - NodeID: d2_bimbing_player_jawab
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Iya pak, yang kemarin saya kirim lewat email.
    Choices: []
    NextNodeID: d2_bimbing_dosen_baca
  - NodeID: d2_bimbing_dosen_baca
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Dosen membaca. Pelan. Kamu menghitung ubin lantai tanpa sadar.
    Choices: []
    NextNodeID: d2_bimbing_inner_tunggu
  - NodeID: d2_bimbing_inner_tunggu
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Satu. Dua. Tiga...
    Choices: []
    NextNodeID: d2_bimbing_dosen_respons
  - NodeID: d2_bimbing_dosen_respons
    SrcImgSprite: {fileID: 0}
    CharName: Dosen
    Text: Masih kurang.
    Choices: []
    NextNodeID: d2_bimbing_inner_jatuh
  - NodeID: d2_bimbing_inner_jatuh
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
