  _dialogueNodes:
  - NodeID: d2_post_act5_keluar
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: "Pintu ruang dosen tertutup di belakangmu. Lorong terasa lebih panjang
      dari tadi \u2014 padahal jaraknya sama."
    Choices: []
    NextNodeID: d2_post_act5_inner_01
  - NodeID: d2_post_act5_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Masih kurang.
    Choices: []
    NextNodeID: d2_post_act5_inner_02
  - NodeID: d2_post_act5_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Gue udah revisi semua yang diminta. Kurangnya di mana lagi?
    Choices: []
    NextNodeID: d2_post_act5_inner_03
  - NodeID: d2_post_act5_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Atau emang gue yang kurang?
    Choices: []
    NextNodeID: d2_post_act5_inner_04
  - NodeID: d2_post_act5_inner_04
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Stop. Jangan ke sana.
    Choices: []
    NextNodeID: d2_post_act5_narasi
  - NodeID: d2_post_act5_narasi
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Tapi pikiran tidak selalu bisa dihentikan hanya dengan diperintah. Dan
      kamu tahu itu lebih dari siapapun.
    Choices: []
    NextNodeID: 
