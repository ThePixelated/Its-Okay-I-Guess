  _dialogueNodes:
  - NodeID: d2_pre2_selesai_mandi
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Oke. Sudah mandi.
    Choices: []
    NextNodeID: d2_pre2_catatan
  - NodeID: d2_pre2_catatan
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Catatan revisi. Baca sekali lagi biar yakin.
    Choices: []
    NextNodeID: d2_pre2_baca
  - NodeID: d2_pre2_baca
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Perbaiki rumusan masalah. Sudah. Tambahkan referensi bab dua. Sudah. Perjelas metodologi. Su... sudah kayaknya.
    Choices: []
    NextNodeID: d2_pre2_tidak_yakin
  - NodeID: d2_pre2_tidak_yakin
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Harusnya sudah. Tapi kenapa masih ngerasa
          ada yang kurang?
    Choices: []
    NextNodeID: d2_pre2_paksa_yakin
  - NodeID: d2_pre2_paksa_yakin
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Udah. Cukup. Masukin ke tas, berangkat.
    Choices: []
