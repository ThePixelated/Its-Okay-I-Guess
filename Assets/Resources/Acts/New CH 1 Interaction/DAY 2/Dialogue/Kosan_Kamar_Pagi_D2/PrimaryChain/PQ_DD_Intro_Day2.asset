  _dialogueNodes:
  - NodeID: intro_d2_narasi_01
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Hari kedua. Alarm berbunyi di jam yang sama. Tapi tubuhmu terasa seperti
      belum benar-benar selesai beristirahat.
    Choices: []
    NextNodeID: intro_d2_narasi_02
  - NodeID: intro_d2_narasi_02
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Hari ini ada bimbingan. Kamu sudah tahu sejak kemarin malam. Dan justru
      karena itu, tidurmu tidak pernah benar-benar tenang.
    Choices: []
    NextNodeID: intro_d2_inner_01
  - NodeID: intro_d2_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Hoamm...
    Choices: []
    NextNodeID: intro_d2_inner_02
  - NodeID: intro_d2_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Bimbingan hari ini...
    Choices: []
    NextNodeID: intro_d2_inner_03
  - NodeID: intro_d2_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Udah direvisi semua kemarin. Harusnya oke.
    Choices: []
    NextNodeID: intro_d2_inner_04
  - NodeID: intro_d2_inner_04
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: ...harusnya.
    Choices: []
    NextNodeID: 
