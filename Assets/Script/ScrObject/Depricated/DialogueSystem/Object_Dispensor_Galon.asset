  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4fcb2e8873b74e4409684504bb478848, type: 3}
  m_Name: Object_Dispensor_Galon
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  isDialogueRead: 0
  _dialogueNodes:
  - NodeID: start_thirsty
    SrcImgSprite: {fileID: 0}
    CharName: Leanst
    Text: '*Tenggorokan gue rasanya kayak padang pasir. Kayaknya tadi lupa minum
      pas di tempat kerja.*'
    Choices: []
    NextNodeID: check_dispenser
  - NodeID: check_dispenser
    SrcImgSprite: {fileID: -9045903315553155012, guid: 2982ba0054100264097c63abe86225d3, type: 3}
    CharName: Dispenser
    Text: .....
    Choices:
    - text: Pencet keran air dingin.
      NextNodeID: press_cold
    - text: Cek kondisi galon di atas.
      NextNodeID: check_gallon
    NextNodeID: 
  - NodeID: press_cold
    SrcImgSprite: {fileID: 532282208441007744, guid: fc8b48363ac9d964ab8a6cbd6d052af4, type: 3}
    CharName: Dispenser
    Text: '*Pshhh... hhh...*'
    Choices: []
    NextNodeID: empty_noise
  - NodeID: empty_noise
    SrcImgSprite: {fileID: 0}
    CharName: Leanst
    Text: '*Cuma suara angin. Ini mah beneran kering sampe ke akar-akarnya.*'
    Choices: []
    NextNodeID: check_gallon
  - NodeID: check_gallon
    SrcImgSprite: {fileID: 8420485207997377320, guid: 8aa48c91b3f6b594498a107bd5b19d1f, type: 3}
    CharName: Galon Kosong
    Text: '*Goyang-goyang pelan*'
    Choices: []
    NextNodeID: gallon_monologue
  - NodeID: gallon_monologue
    SrcImgSprite: {fileID: 0}
    CharName: Leanst
    Text: '*Enteng banget. Siapa sih yang abisin terakhir tapi nggak langsung ganti?!*'
    Choices:
    - text: Coba goyangin lebih keras, siapa tahu ada sisa.
      NextNodeID: shake_hard
    - text: Nyerah, mending tidur aja.
      NextNodeID: give_up
    NextNodeID: 
  - NodeID: shake_hard
    SrcImgSprite: {fileID: 532282208441007744, guid: fc8b48363ac9d964ab8a6cbd6d052af4, type: 3}
    CharName: Galon Kosong
    Text: GLUK...
    Choices: []
    NextNodeID: last_drop
  - NodeID: last_drop
    SrcImgSprite: {fileID: 0}
    CharName: Leanst
    Text: '*Cuma dapet satu teguk kecil... mending daripada nggak sama sekali.*'
    Choices: []
    NextNodeID: 
  - NodeID: give_up
    SrcImgSprite: {fileID: 0}
    CharName: Leanst
    Text: '*Males banget angkat galon malem-malem begini. Besok pagi aja lah pas
      mau bimbingan.*'
    Choices: []
    NextNodeID: 
  setRead: 0
