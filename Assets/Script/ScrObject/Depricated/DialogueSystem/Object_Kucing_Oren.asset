    CharName: Kucing Oren
    Text: Meoooong...
    Choices: []
    NextNodeID: after_pet
  - NodeID: after_pet
    SrcImgSprite: {fileID: 0}
    CharName: Leanst
    Text: '*Suaranya serak. Beneran lagi nggak enak badan kayaknya si kucing preman
      ini.*'
    Choices: []
    NextNodeID: 
  - NodeID: look_cat
    SrcImgSprite: {fileID: 21300000, guid: 927b120debba99043b2154c16dd86e7c, type: 3}
