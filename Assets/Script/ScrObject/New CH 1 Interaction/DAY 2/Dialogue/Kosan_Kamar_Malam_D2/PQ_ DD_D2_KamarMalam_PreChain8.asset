  _dialogueNodes:
  - NodeID: d2_pre8_masuk_kamar
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: "Kamar. Lebih berantakan dari semalam \u2014 tadi pagi terburu-buru. Biasanya
      ini mengganggu. Malam ini tidak terlalu."
    Choices: []
    NextNodeID: d2_pre8_inner_01
  - NodeID: d2_pre8_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Catat dulu revisinya. Sebelum lupa.
    Choices: []
    NextNodeID: d2_pre8_inner_02
  - NodeID: d2_pre8_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Padahal yang dibilang dospem tadi juga masih belum jelas kurangnya di mana.
    Choices: []
    NextNodeID: d2_pre8_inner_03
  - NodeID: d2_pre8_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Tapi nulis dulu aja. Biar ada yang bisa dikerjain besok.
    Choices: []
    NextNodeID: 
