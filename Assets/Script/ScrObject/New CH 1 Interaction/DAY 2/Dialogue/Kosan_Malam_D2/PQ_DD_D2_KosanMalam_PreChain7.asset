    NextNodeID: d2_pre7_inner_01
  - NodeID: d2_pre7_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Tas dulu.
    Choices: []
    NextNodeID: d2_pre7_inner_02
  - NodeID: d2_pre7_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Laper. Tapi males masak.
    Choices: []
