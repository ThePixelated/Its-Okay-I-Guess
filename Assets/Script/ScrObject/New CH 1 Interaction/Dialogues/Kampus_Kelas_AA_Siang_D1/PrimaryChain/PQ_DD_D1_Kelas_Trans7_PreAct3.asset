  _dialogueNodes:
  - NodeID: trans7_kelas_bubar
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Kelas mulai bubar. Teman-teman sekitarmu sudah packing
          tas, mengobrol, tertawa soal hal-hal yang tidak kamu
          ikuti. Kamu masih duduk.
    Choices: []
    NextNodeID: trans7_inner_duduk
  - NodeID: trans7_inner_duduk
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Tiga ratus ribu. Dari mana?
    Choices: []
    NextNodeID: trans7_inner_opsi
  - NodeID: trans7_inner_opsi
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Minta orang tua? Atau... cari kerjaan tambahan?
    Choices: []
    NextNodeID: trans7_inner_berat
  - NodeID: trans7_inner_berat
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Dua-duanya berat.
    Choices: []
    NextNodeID: trans7_inner_gerak
  - NodeID: trans7_inner_gerak
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Yaudah. Gerak dulu.
    Choices: []
