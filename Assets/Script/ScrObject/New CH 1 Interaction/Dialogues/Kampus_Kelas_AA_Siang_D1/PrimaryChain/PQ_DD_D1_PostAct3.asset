  _dialogueNodes:
  - NodeID: post_act3_narasi
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Keputusan sudah dibuat. Bukan berarti mudah — hanya
          berarti sudah selesai untuk sekarang. Kelas sudah
          kosong. Waktunya pulang.
    Choices: []
    NextNodeID: post_act3_inner_01
  - NodeID: post_act3_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Capek juga ya, baru siang udah kepikiran banyak banget.
    Choices: []
    NextNodeID: post_act3_inner_02
  - NodeID: post_act3_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Yaudah. Pulang dulu. Istirahat sebentar.
    Choices: []
    NextNodeID: post_act3_inner_03
  - NodeID: post_act3_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Semoga sore ini lebih tenang.
    Choices: []
    NextNodeID:
