  _dialogueNodes:
  - NodeID: pre10_masuk_kamar
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: "Kamar kosan malam hari selalu terasa berbeda dari pagi. Lebih sempit.
      Lebih sunyi. Tapi juga lebih jujur \u2014 tidak ada yang perlu kamu tunjukkan
      di sini."
    Choices: []
    NextNodeID: pre10_inner_01
  - NodeID: pre10_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Berantakan juga ya kamarnya...
    Choices: []
    NextNodeID: pre10_inner_02
  - NodeID: pre10_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Beresin dulu ah. Biar agak tenang.
    Choices: []
    NextNodeID: pre10_inner_03
  - NodeID: pre10_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Setidaknya kamar bisa dirapiin. Tidak seperti yang lain.
    Choices: []
