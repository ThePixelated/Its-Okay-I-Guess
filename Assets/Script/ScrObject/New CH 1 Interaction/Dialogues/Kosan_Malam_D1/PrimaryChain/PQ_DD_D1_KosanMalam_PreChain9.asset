  _dialogueNodes:
  - NodeID: pre9_tiba_kosan
    SrcImgSprite: {fileID: 0}
    CharName: 
    Text: Kosan. Akhirnya. Tempat yang tidak pernah memintamu untuk jadi siapapun
      selain dirimu sendiri.
    Choices: []
    NextNodeID: pre9_inner_01
  - NodeID: pre9_inner_01
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Capek banget hari ini.
    Choices: []
    NextNodeID: pre9_inner_02
  - NodeID: pre9_inner_02
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Eh, ada yang masak. Enak baunya.
    Choices: []
    NextNodeID: pre9_inner_03
  - NodeID: pre9_inner_03
    SrcImgSprite: {fileID: 0}
    CharName: Anggi
    Text: Oh iya, galon. Udah habis dari kemarin.
    Choices: []
    NextNodeID: pre9_inner_04
